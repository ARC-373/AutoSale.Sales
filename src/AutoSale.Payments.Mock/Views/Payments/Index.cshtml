@model IReadOnlyList<PaymentResponse>
@{
    ViewData["Title"] = "Pagamentos pendentes";
}
<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · AutoSale</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<main class="container">
    <header>
        <div>
            <span class="eyebrow">AUTOSALE · MOCK</span>
            <h1>Pagamentos pendentes</h1>
            <p>Aprove ou cancele os pagamentos enviados pelo serviço de Vendas.</p>
        </div>
        <a class="refresh" href="/">Atualizar lista</a>
    </header>

    @if (TempData["Message"] is string message)
    {
        <div class="notice success">@message</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="notice error">@error</div>
    }

    @if (Model.Count == 0)
    {
        <section class="empty">
            <strong>Nenhum pagamento aguardando decisão.</strong>
            <span>A lista será preenchida quando Vendas registrar uma nova compra.</span>
        </section>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                <tr><th>Pagamento</th><th>Venda</th><th>Valor</th><th>Criado em</th><th>Ações</th></tr>
                </thead>
                <tbody>
                @foreach (var payment in Model)
                {
                    <tr>
                        <td><code>@payment.PaymentCode</code></td>
                        <td><code>@payment.SaleId</code></td>
                        <td class="amount">@payment.Amount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</td>
                        <td>@payment.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="actions">
                            <form method="post" action="/payments/@payment.PaymentCode/approve">
                                @Html.AntiForgeryToken()
                                <button class="approve" type="submit">Aprovar</button>
                            </form>
                            <form method="post" action="/payments/@payment.PaymentCode/cancel">
                                @Html.AntiForgeryToken()
                                <button class="cancel" type="submit">Cancelar</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</main>
</body>
</html>
